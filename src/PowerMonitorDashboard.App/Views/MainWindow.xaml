<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PowerMonitorDashboard.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PowerMonitorDashboard.Controls"
        xmlns:validation="clr-namespace:PowerMonitorDashboard.Validation"
        Title="电力行业可视化大屏监控系统"
        Width="1700" Height="980"
        MinWidth="1280" MinHeight="780"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource AppBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}">

  <!-- 全局快捷键 -->
  <Window.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    <KeyBinding Key="F11" Command="{Binding ToggleFullScreenCommand}" />
    <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportHistoryCommand}" />
    <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OpenSettingsCommand}" />
    <KeyBinding Key="Q" Modifiers="Control" Command="{Binding ExitCommand}" />
  </Window.InputBindings>

  <Window.Resources>
    <!-- ===================== 拓扑图节点模板 ===================== -->
    <DataTemplate x:Key="GeneratorNodeTemplate">
      <Grid Width="{Binding Width}" Height="{Binding Height}" Opacity="{Binding Opacity}" Cursor="Hand">
        <Grid.ToolTip>
          <StackPanel MaxWidth="230">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding LoadText, StringFormat=出力 {0}}" FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" />
          </StackPanel>
        </Grid.ToolTip>
        <Border Background="{Binding FillBrush}" BorderBrush="{Binding BorderBrush}"
                BorderThickness="{Binding BorderThickness}" CornerRadius="4">
          <Grid Margin="6,3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Path Data="{StaticResource IconTurbine}" Fill="{StaticResource Level10Brush}"
                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding LoadText}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="TransformerNodeTemplate">
      <Grid Width="{Binding Width}" Height="{Binding Height}" Opacity="{Binding Opacity}" Cursor="Hand">
        <Grid.ToolTip>
          <StackPanel MaxWidth="230">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding LoadText, StringFormat=通过功率 {0}}" FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" />
          </StackPanel>
        </Grid.ToolTip>
        <Border Background="{Binding FillBrush}" BorderBrush="{Binding BorderBrush}"
                BorderThickness="{Binding BorderThickness}" CornerRadius="4">
          <StackPanel VerticalAlignment="Center" Margin="3,1">
            <TextBlock Text="{Binding Name}" FontSize="9" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding LoadText}" FontSize="8" Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SubstationNodeTemplate">
      <Grid Width="{Binding Width}" Height="{Binding Height}" Opacity="{Binding Opacity}" Cursor="Hand">
        <Grid.ToolTip>
          <StackPanel MaxWidth="230">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding LoadText, StringFormat=负荷 {0}}" FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" />
          </StackPanel>
        </Grid.ToolTip>
        <Ellipse Fill="{Binding FillBrush}" Stroke="{Binding BorderBrush}" StrokeThickness="{Binding BorderThickness}" />
        <Ellipse x:Name="AlertRing" Stroke="{StaticResource DangerBrush}" StrokeThickness="1.6"
                 Margin="-5" Opacity="0" Visibility="{Binding IsAlert, Converter={StaticResource BoolToVisibility}}" />
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding LevelText}" FontSize="8.5" HorizontalAlignment="Center"
                     Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0" />
        </StackPanel>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsAlert}" Value="True">
          <DataTrigger.EnterActions>
            <BeginStoryboard x:Name="AlertStoryboard">
              <Storyboard RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="AlertRing" Storyboard.TargetProperty="Opacity"
                                 From="0.15" To="0.95" Duration="0:0:0.7" AutoReverse="True" />
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <StopStoryboard BeginStoryboardName="AlertStoryboard" />
          </DataTrigger.ExitActions>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="BusbarNodeTemplate">
      <Grid Width="{Binding Width}" Height="{Binding Height}" Opacity="{Binding Opacity}" Cursor="Hand">
        <Grid.ToolTip>
          <StackPanel MaxWidth="240">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding LoadText, StringFormat=母线电压 {0}}" FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" />
          </StackPanel>
        </Grid.ToolTip>
        <Rectangle Fill="{Binding BorderBrush}" RadiusX="3" RadiusY="3" Opacity="0.9" />
        <TextBlock Text="220kV" FontSize="8.5" Foreground="{StaticResource TextSecondaryBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock.LayoutTransform>
            <RotateTransform Angle="-90" />
          </TextBlock.LayoutTransform>
        </TextBlock>
        <Ellipse x:Name="AlertRing" Stroke="{StaticResource DangerBrush}" StrokeThickness="1.4"
                 Margin="-6" Opacity="0" Visibility="{Binding IsAlert, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsAlert}" Value="True">
          <DataTrigger.EnterActions>
            <BeginStoryboard x:Name="BusAlertStoryboard">
              <Storyboard RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="AlertRing" Storyboard.TargetProperty="Opacity"
                                 From="0.1" To="0.9" Duration="0:0:0.6" AutoReverse="True" />
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <StopStoryboard BeginStoryboardName="BusAlertStoryboard" />
          </DataTrigger.ExitActions>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="LoadNodeTemplate">
      <Grid Width="{Binding Width}" Height="{Binding Height}" Opacity="{Binding Opacity}" Cursor="Hand">
        <Grid.ToolTip>
          <StackPanel MaxWidth="230">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding LoadText, StringFormat=负荷 {0}}" FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" />
          </StackPanel>
        </Grid.ToolTip>
        <Border Background="{Binding FillBrush}" BorderBrush="{Binding BorderBrush}"
                BorderThickness="{Binding BorderThickness}" CornerRadius="4">
          <StackPanel VerticalAlignment="Center" Margin="6,2">
            <TextBlock Text="{Binding Name}" FontSize="9.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding LoadText}" FontSize="8.5" Foreground="{StaticResource TextMutedBrush}" />
          </StackPanel>
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="GridNodeTemplate">
      <Grid Width="{Binding Width}" Height="{Binding Height}" Opacity="{Binding Opacity}" Cursor="Hand">
        <Grid.ToolTip>
          <StackPanel MaxWidth="240">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding LoadText, StringFormat=联络功率 {0}}" FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" />
          </StackPanel>
        </Grid.ToolTip>
        <Border Background="{Binding FillBrush}" BorderBrush="{Binding BorderBrush}"
                BorderThickness="{Binding BorderThickness}" CornerRadius="16">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding LevelText}" FontSize="8" Foreground="{StaticResource Level500Brush}" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="LinkTemplate">
      <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
            Stroke="{Binding Stroke}" StrokeThickness="{Binding Thickness}" Opacity="{Binding Opacity}"
            StrokeDashArray="3 4" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
        <Line.Triggers>
          <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
              <Storyboard RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetProperty="StrokeDashOffset" From="0" To="-14" Duration="0:0:1.1" />
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Line.Triggers>
      </Line>
    </DataTemplate>

    <controls:TopologyNodeTemplateSelector x:Key="TopologyNodeSelector" />
  </Window.Resources>

  <!-- ===================== 页面骨架 ===================== -->
  <Grid Margin="14,10,14,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 播放视频时缓慢循环渐变的背景光晕 -->
    <Rectangle x:Name="BackgroundPulse" Grid.Row="0" Grid.RowSpan="5" IsHitTestVisible="False"
               Panel.ZIndex="-1" Opacity="0" RadiusX="12" RadiusY="12">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop x:Name="BgStopA" Color="#FF071A28" Offset="0" />
          <GradientStop x:Name="BgStopB" Color="#FF0A2C3E" Offset="0.5" />
          <GradientStop x:Name="BgStopC" Color="#FF0B2536" Offset="1" />
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <!-- ===================== 顶栏 ===================== -->
    <Border Grid.Row="0" Height="60" CornerRadius="10"
            Background="{StaticResource HeaderGradientBrush}"
            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
      <Grid Margin="16,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="38" Height="38" CornerRadius="9" Background="{StaticResource AccentGradientBrush}">
            <Path Data="{StaticResource IconBolt}" Fill="#FF04121A" Width="22" Height="22" Stretch="Uniform" />
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" Style="{StaticResource DisplayTitle}" FontSize="19" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Style="{StaticResource Pill}">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsConnectionHealthy}" Value="False">
                        <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock Text="{Binding ConnectionText}" Margin="7,0,0,0" Style="{StaticResource Secondary}" FontSize="11.5" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Pill}" Margin="8,0,0,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="采样周期" Style="{StaticResource Caption}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding SamplingIntervalText}" Style="{StaticResource Mono}" Margin="6,0,0,0"
                         Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Pill}" Margin="8,0,0,0"
                  Visibility="{Binding Alarms.HasActive, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource IconWarning}" Fill="{StaticResource WarningBrush}" Width="12" Height="12"
                    Stretch="Uniform" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Alarms.SummaryText}" Margin="6,0,0,0" FontSize="11.5"
                         Foreground="{StaticResource WarningBrush}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Text="{Binding ClockText}" Style="{StaticResource ClockText}" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding DateText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
          </StackPanel>
          <Button Style="{StaticResource GhostButton}" Command="{Binding ToggleAcquisitionCommand}"
                  Margin="0,0,6,0" ToolTip="暂停 / 恢复实时采集">
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource IconPause}" Width="11" Height="11" Stretch="Uniform"
                    Fill="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding AcquisitionButtonText}" Margin="6,0,0,0" FontSize="11.5" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}" ToolTip="立即刷新数据（F5）">
            <Path Data="{StaticResource IconRefresh}" Style="{StaticResource IconPath}" />
          </Button>
          <Button Style="{StaticResource IconButton}" Command="{Binding DisturbanceCommand}" ToolTip="故障演练：注入一次扰动">
            <Path Data="{StaticResource IconWarning}" Style="{StaticResource IconPath}" />
          </Button>
          <Button Style="{StaticResource IconButton}" Command="{Binding OpenSettingsCommand}" ToolTip="系统设置（Ctrl+,）">
            <Path Data="{StaticResource IconSettings}" Style="{StaticResource IconPath}" />
          </Button>
          <Button Style="{StaticResource IconButton}" Command="{Binding ToggleFullScreenCommand}" ToolTip="全屏显示（F11）">
            <Path Data="{StaticResource IconFullscreen}" Style="{StaticResource IconPath}" />
          </Button>
          <Button Style="{StaticResource IconButton}" Command="{Binding ExitCommand}" ToolTip="退出（Ctrl+Q）">
            <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===================== KPI 卡片 ===================== -->
    <Grid Grid.Row="1" Height="124" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- 电压 -->
      <Border Grid.Column="0" Style="{StaticResource KpiCard}" Margin="0,0,10,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <Rectangle Width="3" Height="12" Fill="{StaticResource Level220Brush}" RadiusX="1.5" RadiusY="1.5"
                         VerticalAlignment="Center" />
              <TextBlock Text="母线电压" Margin="8,0,0,0" Style="{StaticResource Secondary}" />
              <Border Style="{StaticResource Badge}" Background="#1A22D3EE" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="U" FontSize="9.5" Foreground="{StaticResource AccentBrush}" />
              </Border>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding Live.StatusSummary}" Style="{StaticResource Caption}"
                       TextTrimming="CharacterEllipsis" MaxWidth="170" VerticalAlignment="Center" />
          </Grid>
          <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding Live.Reading.VoltageText}" Style="{StaticResource MetricValue}" />
            <TextBlock Text="kV" Style="{StaticResource MetricUnit}" />
          </StackPanel>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Bottom">
              <TextBlock Text="{Binding Live.VoltageHint}" Style="{StaticResource Caption}" />
              <TextBlock Text="{Binding Live.PowerFactorText, StringFormat=功率因数 {0}}" Style="{StaticResource Caption}"
                         Margin="0,2,0,0" />
            </StackPanel>
            <controls:TrendChart Grid.Column="1" Width="88" Height="34" VerticalAlignment="Bottom"
                                 Values="{Binding Live.VoltageSeries}"
                                 Minimum="{Binding Live.VoltageAxisMin}" Maximum="{Binding Live.VoltageAxisMax}"
                                 ShowAxis="False" LineBrush="{StaticResource Level220Brush}" ValueFormat="F1" />
          </Grid>
        </Grid>
      </Border>

      <!-- 电流 -->
      <Border Grid.Column="1" Style="{StaticResource KpiCard}" Margin="0,0,10,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <Rectangle Width="3" Height="12" Fill="{StaticResource Level10Brush}" RadiusX="1.5" RadiusY="1.5"
                       VerticalAlignment="Center" />
            <TextBlock Text="线路电流" Margin="8,0,0,0" Style="{StaticResource Secondary}" />
            <Border Style="{StaticResource Badge}" Background="#1A7DD3FC" Margin="8,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="I" FontSize="9.5" Foreground="{StaticResource Level10Brush}" />
            </Border>
          </StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding Live.Reading.CurrentText}" Style="{StaticResource MetricValue}" />
            <TextBlock Text="A" Style="{StaticResource MetricUnit}" />
          </StackPanel>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Bottom">
              <TextBlock Style="{StaticResource Caption}">
                <Run Text="负荷率 " />
                <Run Text="{Binding Live.LoadRateText, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" />
                <Run Text=" · 今日 " />
                <Run Text="{Binding Live.DailyEnergyText, Mode=OneWay}" />
                <Run Text=" MWh" />
              </TextBlock>
              <TextBlock Text="{Binding Live.Reading.ApparentPowerMva, StringFormat=视在功率 {0:F1} MVA}"
                         Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </StackPanel>
            <controls:TrendChart Grid.Column="1" Width="88" Height="34" VerticalAlignment="Bottom"
                                 Values="{Binding Live.CurrentSeries}"
                                 Minimum="0" Maximum="2000"
                                 ShowAxis="False" LineBrush="{StaticResource Level10Brush}" ValueFormat="F0" />
          </Grid>
        </Grid>
      </Border>

      <!-- 有功功率 -->
      <Border Grid.Column="2" Style="{StaticResource KpiCard}" Margin="0,0,10,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <Rectangle Width="3" Height="12" Fill="{StaticResource SuccessBrush}" RadiusX="1.5" RadiusY="1.5"
                       VerticalAlignment="Center" />
            <TextBlock Text="有功功率" Margin="8,0,0,0" Style="{StaticResource Secondary}" />
            <Border Style="{StaticResource Badge}" Margin="8,0,0,0" VerticalAlignment="Center"
                    Background="#1A2DD4A7">
              <TextBlock Text="{Binding Live.Reading.PowerMw, Converter={StaticResource PowerLevel}}"
                         FontSize="9.5" FontWeight="SemiBold"
                         Foreground="{Binding Live.Reading.PowerMw, Converter={StaticResource PowerLevelBrush}}" />
            </Border>
          </StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding Live.Reading.PowerText}" Style="{StaticResource MetricValue}" />
            <TextBlock Text="MW" Style="{StaticResource MetricUnit}" />
          </StackPanel>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Bottom">
              <TextBlock Text="{Binding Live.PowerHint}" Style="{StaticResource Caption}" />
              <TextBlock Text="{Binding Live.Reading.PowerMw, Converter={StaticResource PowerLevel}, StringFormat=负荷等级：{0}}"
                         Style="{StaticResource Caption}" Margin="0,2,0,0"
                         Foreground="{Binding Live.Reading.PowerMw, Converter={StaticResource PowerLevelBrush}}" />
            </StackPanel>
            <controls:TrendChart Grid.Column="1" Width="88" Height="34" VerticalAlignment="Bottom"
                                 Values="{Binding Live.PowerSeries}"
                                 Minimum="{Binding Live.PowerAxisMin}" Maximum="{Binding Live.PowerAxisMax}"
                                 ShowAxis="False" LineBrush="{StaticResource SuccessBrush}" ValueFormat="F0" />
          </Grid>
        </Grid>
      </Border>

      <!-- 频率 -->
      <Border Grid.Column="3" Style="{StaticResource KpiCard}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <Rectangle Width="3" Height="12" Fill="{StaticResource Level110Brush}" RadiusX="1.5" RadiusY="1.5"
                       VerticalAlignment="Center" />
            <TextBlock Text="电网频率" Margin="8,0,0,0" Style="{StaticResource Secondary}" />
            <Path Data="{StaticResource IconWarning}" Fill="{StaticResource DangerBrush}" Width="14" Height="14"
                  Stretch="Uniform" VerticalAlignment="Center" Margin="10,0,0,0"
                  Visibility="{Binding Live.IsFrequencyOutOfBand, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding Live.Reading.FrequencyText}" Style="{StaticResource MetricValue}" />
            <TextBlock Text="Hz" Style="{StaticResource MetricUnit}" />
          </StackPanel>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Bottom">
              <TextBlock Text="{Binding Live.FrequencyHint}" Style="{StaticResource Caption}" />
              <TextBlock Text="{Binding Live.LastUpdateText, StringFormat=更新 {0}}" Style="{StaticResource Caption}"
                         Margin="0,2,0,0" />
            </StackPanel>
            <controls:TrendChart Grid.Column="1" Width="88" Height="34" VerticalAlignment="Bottom"
                                 Values="{Binding Live.FrequencySeries}"
                                 Minimum="{Binding Live.FrequencyAxisMin}" Maximum="{Binding Live.FrequencyAxisMax}"
                                 ShowAxis="False" LineBrush="{StaticResource Level110Brush}" ValueFormat="F2" />
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- ===================== 主区域 ===================== -->
    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.72*" />
        <ColumnDefinition Width="1.12*" />
        <ColumnDefinition Width="0.98*" />
      </Grid.ColumnDefinitions>

      <!-- 左列：拓扑 + 负荷波动 -->
      <Grid Grid.Column="0" Margin="0,0,10,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,4">
              <StackPanel Orientation="Horizontal">
                <Rectangle Width="3" Height="14" Fill="{StaticResource AccentBrush}" RadiusX="1.5" RadiusY="1.5"
                           VerticalAlignment="Center" />
                <TextBlock Text="电网拓扑与潮流" Style="{StaticResource CardTitle}" Margin="8,0,0,0" />
                <TextBlock Text="{Binding Topology.SelectionText}" Style="{StaticResource Caption}"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ItemsControl ItemsSource="{Binding Topology.Legend}" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Margin="9,0,0,0">
                        <Ellipse Width="6" Height="6" Fill="{Binding Brush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" Margin="4,0,0,0"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ComboBox ItemsSource="{Binding Topology.LevelOptions}"
                          SelectedItem="{Binding Topology.SelectedLevel, Mode=TwoWay}"
                          Width="128" Height="28" Margin="12,0,0,0" FontSize="11"
                          SelectionChanged="OnVoltageLevelSelectionChanged" />
              </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
              <Viewbox Stretch="Uniform" StretchDirection="Both" Margin="0,2,0,0">
                <Canvas Width="700" Height="280" ClipToBounds="False">
                  <!-- 远景网格 -->
                  <Rectangle Width="700" Height="280" Fill="Transparent" />
                  <ItemsControl ItemsSource="{Binding Topology.Links}" Canvas.Left="0" Canvas.Top="0"
                                Width="700" Height="280" ItemTemplate="{StaticResource LinkTemplate}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding Topology.Nodes}" Canvas.Left="0" Canvas.Top="0"
                                Width="700" Height="280" ItemTemplateSelector="{StaticResource TopologyNodeSelector}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                      <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                      </Style>
                    </ItemsControl.ItemContainerStyle>
                  </ItemsControl>
                </Canvas>
              </Viewbox>

              <!-- 预警指示：缩放与旋转动画 -->
              <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,2,0,0" Cursor="Hand"
                    Visibility="{Binding Alarms.HasActive, Converter={StaticResource BoolToVisibility}}"
                    ToolTip="存在活动告警，悬停查看动效">
                <Grid.RenderTransform>
                  <TransformGroup>
                    <ScaleTransform x:Name="WarningScale" ScaleX="1" ScaleY="1" />
                    <RotateTransform x:Name="WarningRotate" Angle="0" />
                  </TransformGroup>
                </Grid.RenderTransform>
                <Grid.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                      <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetName="WarningScale" Storyboard.TargetProperty="ScaleX"
                                         From="1" To="1.14" Duration="0:0:0.9" AutoReverse="True" />
                        <DoubleAnimation Storyboard.TargetName="WarningScale" Storyboard.TargetProperty="ScaleY"
                                         From="1" To="1.14" Duration="0:0:0.9" AutoReverse="True" />
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                  <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WarningRotate"
                                                       Storyboard.TargetProperty="Angle">
                          <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                          <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="-14" />
                          <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="14" />
                          <EasingDoubleKeyFrame KeyTime="0:0:0.45" Value="-8" />
                          <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </Grid.Triggers>
                <Border Background="#33FF5D6C" CornerRadius="8" Padding="7,4" BorderBrush="{StaticResource DangerBrush}"
                        BorderThickness="1">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconWarning}" Fill="{StaticResource DangerBrush}" Width="13" Height="13"
                          Stretch="Uniform" />
                    <TextBlock Text="预警" FontSize="10.5" Foreground="{StaticResource DangerBrush}" Margin="5,0,0,0" />
                  </StackPanel>
                </Border>
              </Grid>
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,10,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
              <StackPanel Orientation="Horizontal">
                <Rectangle Width="3" Height="13" Fill="{StaticResource AccentBrush}" RadiusX="1.5" RadiusY="1.5"
                           VerticalAlignment="Center" />
                <TextBlock Text="馈线负荷波动" Style="{StaticResource CardTitle}" Margin="8,0,0,0" />
                <TextBlock Text="按实时功率联动" Style="{StaticResource Caption}" Margin="8,0,0,0"
                           VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="负荷率" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Live.LoadRateText}" Style="{StaticResource Mono}" Margin="5,0,0,0"
                           Foreground="{StaticResource AccentBrush}" />
              </StackPanel>
            </Grid>
            <controls:LoadBars Grid.Row="1" Margin="0,4,0,0"
                               Intensity="{Binding Live.LoadRate}"
                               IsActive="{Binding Live.IsAcquiring}" />
          </Grid>
        </Border>
      </Grid>

      <!-- 中列：趋势 + 告警 -->
      <Grid Grid.Column="1" Margin="0,0,10,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="206" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="*" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,2">
              <StackPanel Orientation="Horizontal">
                <Rectangle Width="3" Height="14" Fill="{StaticResource AccentBrush}" RadiusX="1.5" RadiusY="1.5"
                           VerticalAlignment="Center" />
                <TextBlock Text="实时趋势" Style="{StaticResource CardTitle}" Margin="8,0,0,0" />
                <TextBlock Text="最近 150 点" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding Live.LastUpdateText, StringFormat=更新 {0}}" Style="{StaticResource Caption}"
                         HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="电压" Style="{StaticResource Caption}" />
                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                  <TextBlock Text="{Binding Live.Reading.VoltageText}" Style="{StaticResource Mono}" FontSize="15"
                             Foreground="{StaticResource Level220Brush}" />
                  <TextBlock Text="kV" Style="{StaticResource Caption}" Margin="3,0,0,1" VerticalAlignment="Bottom" />
                </StackPanel>
              </StackPanel>
              <controls:TrendChart Grid.Column="1" Values="{Binding Live.VoltageSeries}"
                                   Minimum="{Binding Live.VoltageAxisMin}" Maximum="{Binding Live.VoltageAxisMax}"
                                   ThresholdLow="{Binding Live.VoltageAttentionLow}"
                                   ThresholdHigh="{Binding Live.VoltageAttentionHigh}"
                                   LineBrush="{StaticResource Level220Brush}" ValueFormat="F1" />
            </Grid>

            <Grid Grid.Row="2" Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="频率" Style="{StaticResource Caption}" />
                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                  <TextBlock Text="{Binding Live.Reading.FrequencyText}" Style="{StaticResource Mono}" FontSize="15"
                             Foreground="{StaticResource Level110Brush}" />
                  <TextBlock Text="Hz" Style="{StaticResource Caption}" Margin="3,0,0,1" VerticalAlignment="Bottom" />
                </StackPanel>
              </StackPanel>
              <controls:TrendChart Grid.Column="1" Values="{Binding Live.FrequencySeries}"
                                   Minimum="{Binding Live.FrequencyAxisMin}" Maximum="{Binding Live.FrequencyAxisMax}"
                                   ThresholdLow="{Binding Live.FrequencyAttentionLow}"
                                   ThresholdHigh="{Binding Live.FrequencyAttentionHigh}"
                                   LineBrush="{StaticResource Level110Brush}" ValueFormat="F2" />
            </Grid>

            <Grid Grid.Row="3" Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="有功功率" Style="{StaticResource Caption}" />
                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                  <TextBlock Text="{Binding Live.Reading.PowerText}" Style="{StaticResource Mono}" FontSize="15"
                             Foreground="{StaticResource SuccessBrush}" />
                  <TextBlock Text="MW" Style="{StaticResource Caption}" Margin="3,0,0,1" VerticalAlignment="Bottom" />
                </StackPanel>
              </StackPanel>
              <controls:TrendChart Grid.Column="1" Values="{Binding Live.PowerSeries}"
                                   Minimum="{Binding Live.PowerAxisMin}" Maximum="{Binding Live.PowerAxisMax}"
                                   ThresholdLow="{Binding Live.PowerAttention}"
                                   LineBrush="{StaticResource SuccessBrush}" ValueFormat="F0" />
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,10,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <Rectangle Width="3" Height="13" Fill="{StaticResource DangerBrush}" RadiusX="1.5" RadiusY="1.5"
                           VerticalAlignment="Center" />
                <TextBlock Text="告警中心" Style="{StaticResource CardTitle}" Margin="8,0,0,0" />
                <Border Style="{StaticResource Badge}" Background="#33FF5D6C" Margin="8,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Alarms.BadgeText}" FontSize="10" Foreground="{StaticResource DangerBrush}" />
                </Border>
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding Alarms.SummaryText}" Style="{StaticResource Caption}"
                         VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="全部确认"
                      Command="{Binding Alarms.AcknowledgeAllCommand}" />
            </Grid>

            <Grid Grid.Row="1">
              <ListBox ItemsSource="{Binding Alarms.Recent}" SelectedItem="{Binding Alarms.SelectedAlarm}"
                       Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Width="3" CornerRadius="2" Background="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                      <StackPanel Grid.Column="1" Margin="9,0,8,0">
                        <TextBlock Text="{Binding Message}" FontSize="11.5" TextWrapping="Wrap" MaxHeight="32"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                          <TextBlock Text="{Binding SeverityText}" FontSize="10"
                                     Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                          <TextBlock Text="{Binding RaisedAtText}" Style="{StaticResource TinyMono}" Margin="8,0,0,0" />
                          <TextBlock Text="{Binding StateText}" Style="{StaticResource TinyMono}" Margin="8,0,0,0" />
                        </StackPanel>
                      </StackPanel>
                      <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="确认" VerticalAlignment="Top"
                              Command="{Binding DataContext.Alarms.AcknowledgeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                              CommandParameter="{Binding}"
                              Visibility="{Binding CanAcknowledge, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="暂无告警，电网运行平稳。" Style="{StaticResource Caption}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding Alarms.HasActive, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- 右列：数据录入 -->
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
              <Rectangle Width="3" Height="14" Fill="{StaticResource AccentBrush}" RadiusX="1.5" RadiusY="1.5"
                         VerticalAlignment="Center" />
              <TextBlock Text="人工数据补录" Style="{StaticResource CardTitle}" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding Entry.IssueCount, StringFormat={}{0} 项校验提示}" Style="{StaticResource Caption}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>

          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,8">
              <TextBlock Text="电压（kV）" Style="{StaticResource FieldLabel}" />
              <TextBox Height="34" Tag="0～500，一位小数">
                <TextBox.Text>
                  <Binding Path="Entry.VoltageText" UpdateSourceTrigger="PropertyChanged" NotifyOnValidationError="True">
                    <Binding.ValidationRules>
                      <validation:VoltageValidationRule />
                    </Binding.ValidationRules>
                  </Binding>
                </TextBox.Text>
              </TextBox>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,8">
              <TextBlock Text="电流（A）" Style="{StaticResource FieldLabel}" />
              <TextBox Height="34" Tag="0～5000，必填">
                <TextBox.Text>
                  <Binding Path="Entry.CurrentText" UpdateSourceTrigger="PropertyChanged" NotifyOnValidationError="True">
                    <Binding.ValidationRules>
                      <validation:CurrentValidationRule />
                    </Binding.ValidationRules>
                  </Binding>
                </TextBox.Text>
              </TextBox>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,8">
              <TextBlock Text="有功功率（MW）" Style="{StaticResource FieldLabel}" />
              <TextBox Height="34" Tag="留空自动计算">
                <TextBox.Text>
                  <Binding Path="Entry.PowerText" UpdateSourceTrigger="PropertyChanged" NotifyOnValidationError="True">
                    <Binding.ValidationRules>
                      <validation:PowerValidationRule />
                    </Binding.ValidationRules>
                  </Binding>
                </TextBox.Text>
              </TextBox>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,8">
              <TextBlock Text="频率（Hz）" Style="{StaticResource FieldLabel}" />
              <TextBox Height="34" Tag="47.0～52.0">
                <TextBox.Text>
                  <Binding Path="Entry.FrequencyText" UpdateSourceTrigger="PropertyChanged" NotifyOnValidationError="True">
                    <Binding.ValidationRules>
                      <validation:FrequencyValidationRule />
                    </Binding.ValidationRules>
                  </Binding>
                </TextBox.Text>
              </TextBox>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
              <Grid>
                <TextBlock Text="采样时间戳" Style="{StaticResource FieldLabel}" />
                <Button Content="现在" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                        Command="{Binding Entry.UseCurrentTimeCommand}" FontSize="11" Margin="0,-3,0,0" />
              </Grid>
              <TextBox Height="34" Tag="yyyy-MM-dd HH:mm:ss">
                <TextBox.Text>
                  <Binding Path="Entry.TimestampText" UpdateSourceTrigger="PropertyChanged" NotifyOnValidationError="True">
                    <Binding.ValidationRules>
                      <validation:TimestampValidationRule />
                    </Binding.ValidationRules>
                  </Binding>
                </TextBox.Text>
              </TextBox>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="#1417" BorderThickness="0" CornerRadius="6" Padding="0"
                    Visibility="{Binding Entry.HasIssues, Converter={StaticResource BoolToVisibility}}">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="#1AF5B93E" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Entry.HasErrors}" Value="True">
                      <Setter Property="Background" Value="#1AFF5D6C" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Border BorderBrush="#33F5B93E" BorderThickness="1" CornerRadius="6" Padding="9,6">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Path Data="{StaticResource IconAlertCircle}" Fill="{StaticResource WarningBrush}" Width="13"
                        Height="13" Stretch="Uniform" VerticalAlignment="Top" Margin="0,1,6,0" />
                  <ScrollViewer Grid.Column="1" MaxHeight="76" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding Entry.ValidationSummary}" TextWrapping="Wrap" FontSize="10.5"
                               Foreground="{StaticResource TextSecondaryBrush}" LineHeight="16" />
                  </ScrollViewer>
                </Grid>
              </Border>
            </Border>

            <StackPanel Grid.Row="1" Margin="0,10,0,0">
              <TextBlock Text="校验规则" Style="{StaticResource Caption}" Margin="0,0,0,4" />
              <TextBlock Text="· 电压 0～500 kV，最多一位小数" Style="{StaticResource Caption}" Margin="0,1" />
              <TextBlock Text="· 电流 0～5000 A，必填" Style="{StaticResource Caption}" Margin="0,1" />
              <TextBlock Text="· 频率 47.0～52.0 Hz；时间戳不得晚于当前时间" Style="{StaticResource Caption}"
                         Margin="0,1" />
              <TextBlock Text="· 功率留空时按 P = √3·U·I·cosφ 自动计算" Style="{StaticResource Caption}" Margin="0,1" />
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,8,0,0">
              <StackPanel Orientation="Horizontal">
                <Button Content="保存数据" Style="{StaticResource PrimaryButton}" Command="{Binding Entry.SaveCommand}"
                        Width="104" />
                <Button Content="重置" Style="{StaticResource GhostButton}" Command="{Binding Entry.ResetCommand}"
                        Margin="8,0,0,0" Width="64" />
                <Button Content="填入实时值" Style="{StaticResource LinkButton}" Command="{Binding Entry.FillFromLiveCommand}"
                        Margin="10,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding Entry.StatusMessage}" TextWrapping="Wrap" FontSize="10.5" Margin="0,7,0,0"
                         MinHeight="16">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Entry.StatusIsError}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- ===================== 底部：视频 + 历史 ===================== -->
    <Grid Grid.Row="3" Height="264" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="560" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,10,0" ClipToBounds="True">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Margin="14,9,14,6">
            <StackPanel Orientation="Horizontal">
              <Rectangle Width="3" Height="13" Fill="{StaticResource AccentBrush}" RadiusX="1.5" RadiusY="1.5"
                         VerticalAlignment="Center" />
              <TextBlock Text="安全操作规程 · 教学视频" Style="{StaticResource CardTitle}" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock Text="{Binding Video.FileName}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" MaxWidth="170" />
              <Border Style="{StaticResource Badge}" Background="#1A22D3EE" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Video.StateText}" FontSize="9.5" Foreground="{StaticResource AccentBrush}" />
              </Border>
            </StackPanel>
          </Grid>

          <Border Grid.Row="1" Background="#FF03080E" CornerRadius="0,0,9,9" ClipToBounds="True">
            <Grid>
              <MediaElement x:Name="Media"
                            Stretch="Uniform"
                            LoadedBehavior="Manual"
                            UnloadedBehavior="Manual"
                            ScrubbingEnabled="True"
                            Volume="{Binding Video.Volume, Mode=OneWay}"
                            IsMuted="{Binding Video.IsMuted, Mode=OneWay}"
                            MediaOpened="OnMediaOpened"
                            MediaEnded="OnMediaEnded"
                            MediaFailed="OnMediaFailed"
                            BufferingStarted="OnMediaBufferingStarted"
                            BufferingEnded="OnMediaBufferingEnded"
                            MouseLeftButtonDown="OnMediaClick" />

              <!-- 加载动画 -->
              <Grid Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding Video.ShowLoading, Converter={StaticResource BoolToVisibility}}">
                <Ellipse Stroke="#FF1B3A52" StrokeThickness="3" />
                <Path Data="M20,2 A18,18 0 0 1 38,20" Stroke="{StaticResource AccentBrush}" StrokeThickness="3"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                  <Path.RenderTransform>
                    <RotateTransform x:Name="SpinnerRotate" CenterX="20" CenterY="20" />
                  </Path.RenderTransform>
                </Path>
                <Grid.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                      <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetName="SpinnerRotate" Storyboard.TargetProperty="Angle"
                                         From="0" To="360" Duration="0:0:1.1" />
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </Grid.Triggers>
              </Grid>

              <!-- 错误提示 -->
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="{Binding Video.HasError, Converter={StaticResource BoolToVisibility}}">
                <Path Data="{StaticResource IconWarning}" Fill="{StaticResource DangerBrush}" Width="26" Height="26"
                      Stretch="Uniform" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Video.ErrorMessage}" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11.5" TextWrapping="Wrap" MaxWidth="320" TextAlignment="Center" Margin="0,8,0,0" />
                <Button Content="重新加载" Style="{StaticResource GhostButton}" Command="{Binding Video.ReloadCommand}"
                        Margin="0,10,0,0" Width="90" HorizontalAlignment="Center" />
              </StackPanel>

              <!-- 控制栏 -->
              <Border VerticalAlignment="Bottom" Background="{StaticResource VideoOverlayBrush}" Padding="12,6,12,8">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <Slider x:Name="PositionSlider" Grid.Row="0" Height="16" Maximum="{Binding Video.DurationSeconds}"
                          Value="{Binding Video.PositionSeconds, Mode=OneWay}"
                          IsEnabled="{Binding Video.CanSeek}"
                          PreviewMouseLeftButtonDown="OnPositionSliderPreviewMouseDown"
                          PreviewMouseLeftButtonUp="OnPositionSliderPreviewMouseUp"
                          ValueChanged="OnPositionSliderValueChanged" />

                  <Grid Grid.Row="1" Margin="0,2,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Style="{StaticResource PlaybackButton}" Command="{Binding Video.PlayPauseCommand}"
                              ToolTip="播放 / 暂停">
                        <Grid>
                          <Path Data="{StaticResource IconPlay}" Width="13" Height="13" Stretch="Uniform"
                                Fill="{StaticResource AccentBrush}"
                                Visibility="{Binding Video.IsPlaying, Converter={StaticResource InverseBoolToVisibility}}" />
                          <Path Data="{StaticResource IconPause}" Width="13" Height="13" Stretch="Uniform"
                                Fill="{StaticResource AccentBrush}"
                                Visibility="{Binding Video.IsPlaying, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                      </Button>
                      <Button Style="{StaticResource PlaybackButton}" Margin="6,0,0,0" Command="{Binding Video.StopCommand}"
                              ToolTip="停止">
                        <Path Data="{StaticResource IconStop}" Width="12" Height="12" Stretch="Uniform"
                              Fill="{StaticResource TextSecondaryBrush}" />
                      </Button>
                      <Button Style="{StaticResource PlaybackButton}" Margin="6,0,0,0" Command="{Binding Video.ToggleMuteCommand}"
                              ToolTip="静音 / 取消静音">
                        <Grid>
                          <Path Data="{StaticResource IconVolume}" Width="13" Height="13" Stretch="Uniform"
                                Fill="{StaticResource TextSecondaryBrush}"
                                Visibility="{Binding Video.IsMuted, Converter={StaticResource InverseBoolToVisibility}}" />
                          <Path Data="{StaticResource IconMute}" Width="13" Height="13" Stretch="Uniform"
                                Fill="{StaticResource DangerBrush}"
                                Visibility="{Binding Video.IsMuted, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                      </Button>
                      <Slider Width="58" Margin="8,0,0,0" Minimum="0" Maximum="1"
                              Value="{Binding Video.Volume, Mode=TwoWay}" ToolTip="音量" />
                      <TextBlock Text="{Binding Video.PositionText}" Style="{StaticResource Mono}" Margin="10,0,0,0"
                                 VerticalAlignment="Center" />
                      <TextBlock Text="/" Style="{StaticResource Caption}" Margin="3,0,3,0" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Video.DurationText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Video.StateText}" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                  </Grid>
                </Grid>
              </Border>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,10" ClipToBounds="True">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
              <Rectangle Width="3" Height="13" Fill="{StaticResource AccentBrush}" RadiusX="1.5" RadiusY="1.5"
                         VerticalAlignment="Center" />
              <TextBlock Text="历史数据" Style="{StaticResource CardTitle}" Margin="8,0,0,0" />
              <TextBlock Text="{Binding History.CountText}" Style="{StaticResource Caption}" Margin="10,0,0,0"
                         VerticalAlignment="Center" />
              <TextBlock Text="{Binding History.FilterText, StringFormat=· {0}}" Style="{StaticResource Caption}"
                         Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <CheckBox Content="仅异常" IsChecked="{Binding History.ShowOnlyAbnormal}" VerticalAlignment="Center"
                        FontSize="11" />
              <CheckBox Content="自动滚动" IsChecked="{Binding History.AutoScroll}" Margin="12,0,0,0"
                        VerticalAlignment="Center" FontSize="11" />
              <Button Style="{StaticResource LinkButton}" Content="导出 CSV" Margin="14,0,0,0"
                      Command="{Binding ExportHistoryCommand}" />
              <Button Style="{StaticResource LinkButton}" Content="清空" Margin="10,0,0,0"
                      Command="{Binding ClearHistoryCommand}" Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
          </Grid>

          <DataGrid x:Name="HistoryGrid" Grid.Row="1" ItemsSource="{Binding History.View}"
                    AlternationCount="2" CanUserSortColumns="True" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="采样时间" Binding="{Binding TimestampText}" Width="148" />
              <DataGridTextColumn Header="电压 (kV)" Binding="{Binding VoltageText}" Width="86">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource Level220Brush}" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="电流 (A)" Binding="{Binding CurrentText}" Width="86">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Right" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="有功功率 (MW)" Binding="{Binding PowerText}" Width="112">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="Foreground" Value="{Binding PowerMw, Converter={StaticResource PowerLevelBrush}}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="频率 (Hz)" Binding="{Binding FrequencyText}" Width="88">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Right" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTemplateColumn Header="负荷等级" Width="78">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Badge}" Background="#1416" HorizontalAlignment="Left"
                            BorderBrush="{Binding PowerMw, Converter={StaticResource PowerLevelBrush}}"
                            BorderThickness="1">
                      <TextBlock Text="{Binding PowerMw, Converter={StaticResource PowerLevel}}" FontSize="10"
                                 Foreground="{Binding PowerMw, Converter={StaticResource PowerLevelBrush}}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="状态" Width="66">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}" FontSize="11"
                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="来源" Binding="{Binding SourceText}" Width="78" />
              <DataGridTextColumn Header="质量" Binding="{Binding QualityText}" Width="56"
                                  Visibility="{Binding DataContext.ShowQualityColumn, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibility}}" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>

    <!-- ===================== 状态栏 ===================== -->
    <Grid Grid.Row="4" Height="24" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" Margin="7,0,0,0"
                   TextTrimming="CharacterEllipsis" MaxWidth="720" />
        <TextBlock Text="{Binding OperatorName, StringFormat=当前值班：{0}}" Style="{StaticResource Caption}"
                   Margin="18,0,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="{Binding History.CountText}" Style="{StaticResource Caption}" />
        <TextBlock Text="{Binding LastSavedText, StringFormat=最近保存 {0}}" Style="{StaticResource Caption}"
                   Margin="14,0,0,0" />
        <TextBlock Text="{Binding UptimeText, StringFormat=运行 {0}}" Style="{StaticResource Caption}" Margin="14,0,0,0" />
        <Button Content="关于" Style="{StaticResource LinkButton}" Command="{Binding AboutCommand}" Margin="14,0,0,0"
                FontSize="10.5" VerticalAlignment="Center" />
        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" Margin="10,0,0,0" />
        <TextBlock Text="{Binding ShortcutsText}" Style="{StaticResource Caption}" Margin="14,0,0,0"
                   ToolTip="{Binding ShortcutsText}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
      </StackPanel>
    </Grid>

    <!-- ===================== 提示条 ===================== -->
    <Border Grid.Row="2" Panel.ZIndex="99" HorizontalAlignment="Center" VerticalAlignment="Bottom"
            Margin="0,0,0,16" Padding="16,9" CornerRadius="8" Background="#F00A1B2A"
            BorderBrush="{Binding NotificationBrush}" BorderThickness="1"
            Visibility="{Binding IsNotificationVisible, Converter={StaticResource BoolToVisibility}}">
      <Border.Effect>
        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Color="#FF000000" Opacity="0.6" />
      </Border.Effect>
      <StackPanel Orientation="Horizontal">
        <Ellipse Width="6" Height="6" Fill="{Binding NotificationBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding NotificationText}" Margin="9,0,0,0" FontSize="12" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
