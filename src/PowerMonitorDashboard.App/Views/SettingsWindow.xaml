<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PowerMonitorDashboard.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统设置"
        Width="880" Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource HeaderGradientBrush}" BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="0,0,0,1" Padding="22,14">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Path Data="{StaticResource IconSettings}" Fill="{StaticResource AccentBrush}" Width="18" Height="18"
                Stretch="Uniform" VerticalAlignment="Center" />
          <TextBlock Text="系统设置" Style="{StaticResource SectionTitle}" FontSize="17" Margin="10,0,0,0" />
        </StackPanel>
        <TextBlock Text="修改采样、存储与告警阈值参数，确定后立即生效并写入本地配置文件。"
                   Style="{StaticResource Caption}" Margin="0,5,0,0" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,14,20,10">
      <StackPanel>
        <!-- 采集与存储 -->
        <Border Style="{StaticResource Card}" Padding="18,14">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <Rectangle Width="3" Height="14" Fill="{StaticResource AccentBrush}" RadiusX="1.5" RadiusY="1.5"
                         VerticalAlignment="Center" />
              <TextBlock Text="采集与存储" Style="{StaticResource CardTitle}" Margin="8,0,0,0" />
            </StackPanel>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,10">
                <TextBlock Text="采样周期（毫秒）" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding SamplingIntervalText, UpdateSourceTrigger=PropertyChanged}" Height="34" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,10">
                <TextBlock Text="历史容量（条）" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding HistoryCapacityText, UpdateSourceTrigger=PropertyChanged}" Height="34" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                <TextBlock Text="历史显示行数" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding HistoryDisplayLimitText, UpdateSourceTrigger=PropertyChanged}" Height="34" />
              </StackPanel>

              <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,10">
                <TextBlock Text="假定功率因数（跨字段校验）" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding AssumedPowerFactorText, UpdateSourceTrigger=PropertyChanged}" Height="34" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,10">
                <TextBlock Text="值班员名称" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding OperatorName, UpdateSourceTrigger=PropertyChanged}" Height="34" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                <TextBlock Text="视频文件路径" Style="{StaticResource FieldLabel}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Text="{Binding VideoPath, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,0,6,0" />
                  <Button Grid.Column="1" Content="浏览…" Style="{StaticResource GhostButton}"
                          Command="{Binding BrowseVideoCommand}" Width="58" Height="34" />
                </Grid>
              </StackPanel>

              <WrapPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,4,0,0">
                <CheckBox Content="启动后自动开始采集" IsChecked="{Binding AutoStart}" Margin="0,4,22,4" />
                <CheckBox Content="历史表格自动滚动" IsChecked="{Binding AutoScroll}" Margin="0,4,22,4" />
                <CheckBox Content="显示数据质量列" IsChecked="{Binding ShowQuality}" Margin="0,4,0,4" />
              </WrapPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- 告警阈值 -->
        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,12,0,0">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <Rectangle Width="3" Height="14" Fill="{StaticResource WarningBrush}" RadiusX="1.5" RadiusY="1.5"
                         VerticalAlignment="Center" />
              <TextBlock Text="告警阈值与负荷分级" Style="{StaticResource CardTitle}" Margin="8,0,0,0" />
              <TextBlock Text="阈值变化会立即影响状态评估、告警与图表参考线" Style="{StaticResource Caption}"
                         Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                <TextBlock Text="标称电压（kV）" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding NominalVoltageText}" Height="34" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,10">
                <TextBlock Text="电压注意区间（±%）" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding VoltageAttentionText}" Height="34" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,10,10">
                <TextBlock Text="电压严重区间（±%）" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding VoltageCriticalText}" Height="34" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,10">
                <TextBlock Text="装机容量（MW）" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding InstalledCapacityText}" Height="34" />
              </StackPanel>

              <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                <TextBlock Text="频率告警下限（Hz）" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding FrequencyAttentionLowText}" Height="34" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,10">
                <TextBlock Text="频率告警上限（Hz）" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding FrequencyAttentionHighText}" Height="34" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,10,10">
                <TextBlock Text="频率严重下限（Hz）" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding FrequencyCriticalLowText}" Height="34" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,10">
                <TextBlock Text="频率严重上限（Hz）" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding FrequencyCriticalHighText}" Height="34" />
              </StackPanel>

              <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="电流告警 / 严重（A）" Style="{StaticResource FieldLabel}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" Text="{Binding CurrentAttentionText}" Height="34" Margin="0,0,5,0" />
                  <TextBox Grid.Column="1" Text="{Binding CurrentCriticalText}" Height="34" Margin="5,0,0,0" />
                </Grid>
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,10,0">
                <TextBlock Text="功率告警 / 严重（MW）" Style="{StaticResource FieldLabel}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" Text="{Binding PowerAttentionText}" Height="34" Margin="0,0,5,0" />
                  <TextBox Grid.Column="1" Text="{Binding PowerCriticalText}" Height="34" Margin="5,0,0,0" />
                </Grid>
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,10,0">
                <TextBlock Text="负荷高 / 中阈值（MW）" Style="{StaticResource FieldLabel}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" Text="{Binding PowerBandHighText}" Height="34" Margin="0,0,5,0" />
                  <TextBox Grid.Column="1" Text="{Binding PowerBandLowText}" Height="34" Margin="5,0,0,0" />
                </Grid>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="#FF081521" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0"
            Padding="20,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource DangerBrush}" FontSize="11"
                   TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="520"
                   Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisibility}}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="恢复默认值" Style="{StaticResource GhostButton}" Command="{Binding ResetDefaultsCommand}"
                  Width="100" Height="34" />
          <Button Content="取消" Style="{StaticResource GhostButton}" Click="OnCancelClick" Margin="10,0,0,0"
                  Width="76" Height="34" />
          <Button Content="确定并应用" Style="{StaticResource PrimaryButton}" Click="OnConfirmClick" Margin="10,0,0,0"
                  Width="108" Height="34" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
