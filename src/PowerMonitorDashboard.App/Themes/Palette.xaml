<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ==========================================================
       调色板：深色科技感大屏配色
       ========================================================== -->
  <Color x:Key="BackgroundColor">#FF050B12</Color>
  <Color x:Key="BackgroundAltColor">#FF071320</Color>
  <Color x:Key="SurfaceColor">#FF0A1826</Color>
  <Color x:Key="SurfaceAltColor">#FF0D2033</Color>
  <Color x:Key="SurfaceRaisedColor">#FF10263B</Color>
  <Color x:Key="BorderColor">#FF17324A</Color>
  <Color x:Key="BorderStrongColor">#FF24506E</Color>
  <Color x:Key="AccentColor">#FF22D3EE</Color>
  <Color x:Key="AccentAltColor">#FF3B82F6</Color>
  <Color x:Key="TextPrimaryColor">#FFE8F4FF</Color>
  <Color x:Key="TextSecondaryColor">#FF9FB8CC</Color>
  <Color x:Key="TextMutedColor">#FF64809A</Color>
  <Color x:Key="SuccessColor">#FF2DD4A7</Color>
  <Color x:Key="WarningColor">#FFB93E</Color>
  <Color x:Key="WarningColorFix">#FFF5B93E</Color>
  <Color x:Key="DangerColor">#FFFF5D6C</Color>

  <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="AppBackgroundAltBrush" Color="{StaticResource BackgroundAltColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentAltBrush" Color="{StaticResource AccentAltColor}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#FF1C4B5E" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColorFix}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="Level500Brush" Color="#FF4ADE80" />
  <SolidColorBrush x:Key="Level220Brush" Color="#FFFFC53D" />
  <SolidColorBrush x:Key="Level110Brush" Color="#FFFF6B6B" />
  <SolidColorBrush x:Key="Level10Brush" Color="#FF7DD3FC" />
  <SolidColorBrush x:Key="GridLineBrush" Color="#FF123049" />
  <SolidColorBrush x:Key="OverlayBrush" Color="#99040A10" />
  <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

  <!-- 渐变 -->
  <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FF0B1E2E" />
    <GradientStop Offset="0.55" Color="#FF081420" />
    <GradientStop Offset="1" Color="#FF050B12" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#FF0C1D2D" />
    <GradientStop Offset="0.6" Color="#FF091625" />
    <GradientStop Offset="1" Color="#FF071220" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="KpiGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#FF0E2334" />
    <GradientStop Offset="1" Color="#FF07131F" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Offset="0" Color="#FF22D3EE" />
    <GradientStop Offset="1" Color="#FF3B82F6" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="AccentFadeBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Offset="0" Color="#0022D3EE" />
    <GradientStop Offset="1" Color="#6622D3EE" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="VideoOverlayBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#00050B12" />
    <GradientStop Offset="0.62" Color="#66050B12" />
    <GradientStop Offset="1" Color="#E6050B12" />
  </LinearGradientBrush>

  <!-- 字体 -->
  <FontFamily x:Key="UiFont">Microsoft YaHei UI, Microsoft YaHei, Segoe UI, Arial</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>
  <FontFamily x:Key="NumberFont">Bahnschrift, Segoe UI, Arial</FontFamily>

  <!-- 阴影与发光 -->
  <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="2" Direction="270"
                    Color="#FF000000" Opacity="0.55" RenderingBias="Performance" />
  <DropShadowEffect x:Key="AccentGlow" BlurRadius="20" ShadowDepth="0"
                    Color="#FF22D3EE" Opacity="0.55" RenderingBias="Performance" />
  <DropShadowEffect x:Key="DangerGlow" BlurRadius="18" ShadowDepth="0"
                    Color="#FFFF5D6C" Opacity="0.65" RenderingBias="Performance" />

  <!-- 常用尺寸 -->
  <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>
  <Thickness x:Key="CardPadding">18</Thickness>

</ResourceDictionary>
