<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="PowerMonitorDashboard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PowerMonitorDashboard.Converters"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Palette.xaml" />
        <ResourceDictionary Source="Themes/Typography.xaml" />
        <ResourceDictionary Source="Themes/Icons.xaml" />
        <ResourceDictionary Source="Themes/Buttons.xaml" />
        <ResourceDictionary Source="Themes/Inputs.xaml" />
        <ResourceDictionary Source="Themes/DataDisplay.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
      <conv:BooleanToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
      <conv:InverseBooleanConverter x:Key="InverseBool" />
      <conv:OperatingStatusTextConverter x:Key="StatusText" />
      <conv:OperatingStatusBrushConverter x:Key="StatusBrush" />
      <conv:PowerLevelConverter x:Key="PowerLevel" HighThreshold="400" LowThreshold="250" />
      <conv:PowerLevelBrushConverter x:Key="PowerLevelBrush" HighThreshold="400" LowThreshold="250" />
      <conv:AlarmSeverityBrushConverter x:Key="SeverityBrush" />
      <conv:StringToVisibilityConverter x:Key="EmptyTextToCollapsed" />
      <conv:StringToVisibilityConverter x:Key="EmptyTextToVisible" Invert="True" />
      <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
      <conv:PercentConverter x:Key="Percent" />
      <conv:PercentConverter x:Key="PercentNoSymbol" WithSymbol="False" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
